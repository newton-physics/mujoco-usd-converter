<mujoco model="bodies">
    <worldbody>
        <body name="root_body" pos="1 0 0">
            <geom type="box" size="0.1 0.1 0.1"/>
            <body name="nested_body" pos="0 1 0">
                <geom type="box" size="0.1 0.1 0.1"/>
                <joint type="hinge"/>
            </body>
        </body>

        <body name="kinematic_body" mocap="true" pos="2 0 0">
            <geom type="box" size="0.1 0.1 0.1"/>
            <body name="kinematic_child" pos="0 1 0">
                <geom type="box" size="0.1 0.1 0.1"/>
            </body>
        </body>

        <body name="static_base" pos="2 0 0">
            <geom type="box" size="0.1 0.1 0.1"/>
            <body name="articulated_child" pos="0 1 0">
                <geom type="box" size="0.1 0.1 0.1"/>
                <body name="leaf" pos="0 1 0">
                    <geom type="box" size="0.1 0.1 0.1"/>
                    <joint type="hinge"/>
                </body>
            </body>
        </body>

        <body name="explicit_inertia_principal" pos="3 0 0">
            <inertial pos="0.1 0.2 0.3" quat="0.92388 0 0.38268 0" mass="2" diaginertia="0.2 0.1 0.3"/>
            <geom type="box" size="0.1 0.1 0.1"/>
        </body>

        <body name="explicit_non_unit_inertia_principal" pos="3 0 0">
            <inertial pos="0.1 0.2 0.3" quat="1 0.1664 0 0" mass="2" diaginertia="0.2 0.1 0.3"/>
            <geom type="box" size="0.1 0.1 0.1"/>
        </body>

        <body name="explicit_inertia_full" pos="4 0 0">
            <inertial pos="0.1 0.2 0.3" mass="3" fullinertia="0.4 0.3 0.2 0.05 0.02 0.01"/>
            <geom type="box" size="0.1 0.1 0.1"/>
        </body>

        <body name="regular_dynamic" pos="5 0 0">
            <geom type="box" size="0.1 0.1 0.1"/>
        </body>

        <body name="gravity_compensated" pos="5 0 0" gravcomp="0.2">
            <geom type="box" size="0.1 0.1 0.1"/>
        </body>

        <!-- mass comes from a non-colliding geom, which USD cannot accumulate: the body is baked -->
        <body name="mass_from_visual" pos="6 0 0">
            <geom type="box" size="0.1 0.1 0.1" contype="0" conaffinity="0" mass="3.0"/>
            <geom type="box" size="0.1 0.1 0.1" contype="1" conaffinity="1" mass="1.0"/>
        </body>
        <!-- mass comes solely from colliders, so it is left to USD accumulation -->
        <body name="mass_from_colliders" pos="7 0 0">
            <geom type="box" size="0.1 0.1 0.1" mass="2.0"/>
            <geom type="box" size="0.1 0.1 0.1" pos="0.5 0 0" mass="1.0"/>
        </body>
        <body name="zero_inertia" pos="5 0 0">
            <inertial pos="0.1 0.2 0.3" mass="2" diaginertia="0 0 0"/>
            <geom type="box" size="0.1 0.1 0.1"/>
        </body>
        <!-- a collider MuJoCo counts as massless, which USD would infer mass for: the body is baked -->
        <body name="zero_density_collider" pos="8 0 0">
            <geom type="box" size="0.1 0.1 0.1" mass="2.0"/>
            <geom type="sphere" size="0.3" density="0"/>
        </body>
        <body name="zero_mass_collider" pos="9 0 0">
            <geom type="box" size="0.1 0.1 0.1" mass="2.0"/>
            <geom type="sphere" size="0.3" mass="0"/>
        </body>
        <!-- MuJoCo compiles this body as massless, which a body MassAPI cannot express -->
        <body name="massless_collider" pos="10 0 0">
            <geom type="capsule" size="0.01 0.25" density="0"/>
        </body>
    </worldbody>
</mujoco>
