<mujoco model="mass_bake_compiler">
  <compiler inertiagrouprange="0 2"/>
  <asset>
    <model name="child" file="mass_bake_compiler_child.xml"/>
  </asset>
  <worldbody>
    <!-- the visual geom is outside this model's inertiagrouprange, so mass comes solely from the collider -->
    <body name="mount">
      <geom type="box" size="0.1 0.1 0.1" mass="1.0"/>
      <geom type="box" size="0.1 0.1 0.1" contype="0" conaffinity="0" group="3" mass="2.0"/>
      <attach model="child" body="visual_mass" prefix="attached_"/>
    </body>
    <attach model="child" body="bounded_mass" prefix="second_"/>
  </worldbody>
</mujoco>
