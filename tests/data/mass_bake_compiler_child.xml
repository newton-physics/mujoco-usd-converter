<!--
    Attached into mass_bake_compiler.xml, whose compiler excludes group 3 from inertia.
    This model counts group 3, and bounds every body's mass from below.
-->
<mujoco model="mass_bake_compiler_child">
  <compiler boundmass="0.5"/>
  <worldbody>
    <body name="visual_mass">
      <geom type="box" size="0.1 0.1 0.1" mass="1.0"/>
      <geom type="box" size="0.1 0.1 0.1" contype="0" conaffinity="0" group="3" mass="2.0"/>
    </body>
    <body name="bounded_mass" pos="1 0 0">
      <geom type="box" size="0.1 0.1 0.1" mass="0.1"/>
    </body>
  </worldbody>
</mujoco>
